# ============================================================
# OpenBox 环境变量示例
# 复制为 .env 并按需调整；切勿提交真实 .env
# ============================================================

# ===== FreeAPI (前端 / Vite + Supabase) =====
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== FreeNode 流水线 (scripts/) =====
# 日志级别: DEBUG / INFO / WARNING / ERROR
FREENODE_LOG_LEVEL=INFO
# 结构化 JSON 日志 (ELK/Splunk 兼容); 1=true, 0=false
FREENODE_LOG_JSON=0

# 是否运行 TCP 连通性检查? (较慢, 过滤失效节点)
FREENODE_VERIFY_NODES=true
# 单节点连接超时 (秒)
FREENODE_VERIFY_TIMEOUT=5
# 并发验证 worker 数
FREENODE_VERIFY_WORKERS=50

# 输出保留的最大节点链接数 (vmess/vless/ss/trojan)
FREENODE_MAX_NODES=800
# 输出保留的最大 HTTP(S)/SOCKS4/SOCKS5 代理数
FREENODE_MAX_PROXIES=300

# 并发抓取源数; 留空 = min(16, 启用源数量)
FREENODE_CRAWL_WORKERS=

# 抓取器允许访问的额外主机 (SSRF 防护), 逗号分隔
FREENODE_ALLOWED_HOSTS=raw.githubusercontent.com

# 是否按地区分组输出? (需要 GeoIP 数据)
FREENODE_GEO_ENABLED=false
